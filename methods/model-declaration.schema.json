{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bampita-bico/CDFD/model-declaration.schema.json",
  "title": "Auditable Toy Model Declaration Record",
  "description": "A claim-bounded record for a declared toy model, its native comparator, execution provenance, finite-output audit, and falsification rule.",
  "type": "object",
  "required": [
    "schema_version",
    "model_id",
    "title",
    "status",
    "scientific_context",
    "claim_boundary",
    "model",
    "evaluation",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "model_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["toy", "methods", "preclinical", "empirical"]},
    "scientific_context": {
      "type": "object",
      "required": ["domain", "question", "native_baselines"],
      "properties": {
        "domain": {"type": "string"},
        "question": {"type": "string", "minLength": 1},
        "native_baselines": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/named_record"}
        },
        "decision_context": {"type": "string"}
      },
      "additionalProperties": false
    },
    "claim_boundary": {
      "type": "object",
      "required": ["what_is_tested", "what_is_not_established"],
      "properties": {
        "what_is_tested": {"type": "string", "minLength": 1},
        "what_is_not_established": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["inputs", "state", "equations", "calibration"],
      "properties": {
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/named_record"}},
        "state": {"type": "array", "items": {"$ref": "#/$defs/named_record"}},
        "equations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "calibration": {
          "type": "object",
          "required": ["status", "description"],
          "properties": {
            "status": {"enum": ["none", "prespecified", "fitted", "not_applicable"]},
            "description": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": ["outcomes", "finite_output_audit", "falsification"],
      "properties": {
        "outcomes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/named_record"}},
        "finite_output_audit": {"$ref": "#/$defs/audit"},
        "falsification": {
          "type": "object",
          "required": ["criterion", "result"],
          "properties": {
            "criterion": {"type": "string", "minLength": 1},
            "result": {"enum": ["pass", "fail", "not_run", "not_applicable"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["source_repository", "source_revision", "command", "run_bundle"],
      "properties": {
        "source_repository": {"type": "string"},
        "source_revision": {"type": "string"},
        "command": {"type": "string"},
        "run_bundle": {"type": "string"},
        "runtime_version": {"type": "string"},
        "date_executed": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "named_record": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "units": {"type": "string"}
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "required": ["performed", "all_finite", "scope"],
      "properties": {
        "performed": {"type": "boolean"},
        "all_finite": {"type": ["boolean", "null"]},
        "scope": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
